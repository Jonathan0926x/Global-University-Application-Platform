# ==============================================================================
# Global University Application Platform - Environment Configuration Example
# Copy this file to .env.local or .env for local development
# NEVER commit .env or actual production credentials to source control!
# ==============================================================================

# Application
ENVIRONMENT=development
PORT=3000
API_PORT=8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Authentication (Clerk or Auth0)
AUTH_PROVIDER=clerk
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder

# Database (PostgreSQL 16+ with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/global_university_platform
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/global_university_platform

# Cache & Message Broker (Redis 7.2+)
REDIS_URL=redis://localhost:6379/0

# Object Storage (S3 / Cloudflare R2 for transcripts & applicant documents)
STORAGE_PROVIDER=cloudflare_r2
STORAGE_BUCKET_NAME=student-transcripts-dev
STORAGE_ACCESS_KEY_ID=placeholder_access_key
STORAGE_SECRET_ACCESS_KEY=placeholder_secret_key
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# AI & LLM Inference APIs
GEMINI_API_KEY=placeholder_gemini_api_key
ANTHROPIC_API_KEY=placeholder_anthropic_api_key
OPENAI_API_KEY=placeholder_openai_api_key
