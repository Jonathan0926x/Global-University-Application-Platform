# ==============================================================================
# Global University Application Platform - .gitignore
# Prevents exposure of secrets, credentials, environment configs, and student data
# ==============================================================================

# --- Secrets, Credentials & Environment Files ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
secrets.json
credentials.json
client_secret*.json
service_account*.json
token.json
auth0_credentials.json

# --- Student & Confidential Applicant Data ---
/data/students/
/data/transcripts/
/data/applicant_records/
/uploads/
/storage/documents/
/storage/transcripts/
*.transcript.*

# --- Operating System & Filesystem Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Node.js / Next.js ---
node_modules/
.next/
out/
build/
dist/
.pnp
.pnp.js
# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python / FastAPI ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Local Databases & Vector Stores ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.sqlite
data/*.db
chroma_db/
vector_store/

# --- IDEs & Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Temporary & Scratch Files ---
*.tmp
*.temp
/tmp/
.temp/
