# ==============================================================================
# Global University Application Platform - .gitignore
# Prevents exposure of secrets, credentials, environment configs, and student data
# ==============================================================================

# --- Secrets, Credentials & Environment Files ---
.env
.env.*
!.env.example
!.env.pilot.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
id_rsa*
id_ed25519*
secrets.json
credentials.json
client_secret*.json
service_account*.json
token.json
auth0_credentials.json

# --- Student & Confidential Applicant Data ---
/data/
/data/vault/
/data/students/
/data/transcripts/
/data/applicant_records/
/uploads/
/storage/documents/
/storage/transcripts/
*.transcript.*

# --- Operating System & Filesystem Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# --- Logs & Diagnostics ---
logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# --- Runtime Data ---
pids
*.pid
*.seed
*.pid.lock

# --- Node.js / Next.js / Frontend Ecosystem ---
node_modules/
jspm_packages/
web_modules/
.next
.next/
out
out/
build/
dist/
.output
.nuxt
.nitro/
.cache
.parcel-cache
.vuepress/dist
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/
.dynamodb/
.firebase/
.tern-port
.vscode-test
.pnpm-store
.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
*.tsbuildinfo
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.yarn-integrity
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/
.astro/
.turbo
.nx/cache
.nx/workspace-data
.nx/migrate-runs
coverage
*.lcov
.nyc_output
.grunt
bower_components
build/Release

# --- Python / FastAPI ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Local Databases & Vector Stores ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.sqlite
data/*.db
chroma_db/
vector_store/

# --- IDEs & Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Temporary & Scratch Files ---
*.tmp
*.temp
/tmp/
.temp/
