# ==============================================================================
# UniGlobe Controlled Pilot / Staging Environment Template
# NON-PUBLIC ACCESS ONLY (Bastion / Zero-Trust Tunnel / VPN Restricted)
# NEVER commit populated secrets or invite unverified public students here.
# ==============================================================================

ENVIRONMENT=staging
PROJECT_NAME="UniGlobe Pilot (Controlled Staging)"

# Strict Clerk Authentication (Mock Auth is automatically prohibited in staging)
AUTH_PROVIDER=clerk
ALLOW_DEV_MOCK_DEFAULT_USER=false
CLERK_ISSUER=https://REPLACE_WITH_STAGING_CLERK_DOMAIN.clerk.accounts.dev
CLERK_JWKS_URL=https://REPLACE_WITH_STAGING_CLERK_DOMAIN.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=uniglobe-pilot-api
CLERK_ACCEPTED_ALGORITHMS=RS256
CLERK_JWKS_CACHE_TTL_SECONDS=3600
CLERK_CLOCK_SKEW_SECONDS=30
CLERK_MAX_IAT_AGE_SECONDS=86400
CLERK_SECRET_KEY=REPLACE_WITH_SECRET_MANAGER_VALUE
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY

# Isolated Pilot Database Schema/Instance (NO production student records)
POSTGRES_DB=uniglobe_pilot
POSTGRES_USER=uniglobe_pilot
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://uniglobe_pilot:REPLACE_WITH_STRONG_RANDOM_PASSWORD@postgres_pilot:5432/uniglobe_pilot

# Private Encrypted Document Vault (Cloudflare R2 or AWS S3)
STORAGE_PROVIDER=cloudflare_r2
STORAGE_BUCKET_NAME=uniglobe-pilot-vault-private
STORAGE_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY
VAULT_SIGNING_SECRET=REPLACE_WITH_64_CHAR_HMAC_SECRET
VAULT_PRESIGNED_TTL_SECONDS=300
VAULT_MAX_UPLOAD_SIZE_BYTES=26214400

# Mandatory ClamAV Malware Scanning in Pilot/Staging
SCANNER_BACKEND=clamav
CLAMAV_HOST=clamav_pilot
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10
DOCUMENT_ASYNC_SCAN=false
ALLOW_EXTERNAL_AI_DOCUMENT_EGRESS=false

# Monitoring & Governance
ENABLE_AUTOMATED_EXPIRY_SWEEPS=true
ROUTE_EXPIRY_SWEEP_INTERVAL_SECONDS=3600
SENTRY_DSN=REPLACE_WITH_PILOT_ERROR_MONITORING_DSN
