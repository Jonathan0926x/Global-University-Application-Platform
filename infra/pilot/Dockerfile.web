FROM node:22-alpine AS builder
WORKDIR /app

ARG NEXT_PUBLIC_API_URL=http://127.0.0.1:18000/api/v1
ARG NEXT_PUBLIC_APP_URL=http://127.0.0.1:13000
ARG NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=$NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY \
    NEXT_TELEMETRY_DISABLED=1

RUN corepack enable && corepack prepare pnpm@12.23.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/tsconfig ./packages/tsconfig
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @platform/web...
COPY apps/web ./apps/web
RUN pnpm --filter @platform/web build

FROM node:22-alpine AS runner
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN addgroup -g 10001 -S uniglobe && adduser -u 10001 -S uniglobe -G uniglobe
WORKDIR /app/apps/web
COPY --from=builder --chown=10001:10001 /app/package.json /app/pnpm-workspace.yaml /app/
COPY --from=builder --chown=10001:10001 /app/node_modules /app/node_modules
COPY --from=builder --chown=10001:10001 /app/apps/web /app/apps/web
USER 10001:10001
EXPOSE 3000
CMD ["./node_modules/.bin/next", "start", "-H", "0.0.0.0", "-p", "3000"]
